{
  "services": {
    "quotation-app-admin": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "quotation-app-admin"
      }
    }
  ]
}
